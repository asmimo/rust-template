{
	"name": "mono",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"clean:js": "rm -rf node_modules && rm -rf bun.lock",
		"clean:rust": "rm -rf Cargo.lock && cargo clean",
		"clean:all": "bun clean:js && bun clean:rust",
		"dev": "bun ./scripts/dev.ts --env development",
		"build:script": "tsc && vite build",
		"build:docker": "bun ./scripts/push-to-docker.ts --env production",
		"format:rust": "cargo fmt",
		"format:js": "bunx oxfmt",
		"format:all": "bun format:rust && bun format:js",
		"lint:js": "bunx oxlint",
		"lint:rust.fix": "cargo clippy --fix",
		"lint:js.fix": "bunx oxlint --fix",
		"lint:all.fix": "bun lint:js.fix && bun lint:rust.fix"
	},
	"dependencies": {
		"type-fest": "^5.9.0"
	},
	"devDependencies": {
		"@imacrayon/alpine-ajax": "0.12.7",
		"@inquirer/checkbox": "5.2.3",
		"@inquirer/input": "5.1.4",
		"@inquirer/select": "5.2.3",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/alpinejs": "3.13.11",
		"@types/bun": "1.4.0",
		"alpinejs": "3.16.3",
		"commander": "15.0.0",
		"daisyui": "5.7.22",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"smol-toml": "1.8.0",
		"tailwindcss": "4.3.3",
		"tailwindcss-animated": "2.1.0",
		"valibot": "^1.4.2",
		"vite": "8.2.2"
	},
	"peerDependencies": {
		"typescript": "7.0.2"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "4.63.1",
		"@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
		"lightningcss-linux-x64-gnu": "1.33.0"
	}
}
