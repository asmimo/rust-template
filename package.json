{
	"name": "rust-template",
	"version": "0.1.1",
	"private": true,
	"workspaces": [
		"app/*"
	],
	"type": "module",
	"scripts": {
		"clean:js": "rm -rf node_modules **/*/node_modules dist **/*/dist .turbo",
		"clean:rust": "rm -rf Cargo.lock && cargo clean",
		"clean:all": "bun clean:js && bun clean:rust",
		"dev": "bun ./scripts/dev.ts --env development",
		"push:docker": "bun ./scripts/push-to-docker.ts --env production",
		"lint": "turbo run lint lint:js",
		"format": "turbo run format format:js",
		"check": "turbo run check check:js"
	},
	"devDependencies": {
		"@inquirer/checkbox": "^5.2.5",
		"@inquirer/input": "^5.1.6",
		"@inquirer/select": "^5.2.5",
		"@types/bun": "^1.4.2",
		"commander": "^15.0.0",
		"smol-toml": "^1.9.0",
		"turbo": "^2.11.7",
		"type-fest": "^5.10.0",
		"valibot": "^1.5.0",
		"vite-plus": "^1.0.0"
	},
	"peerDependencies": {
		"typescript": "7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2"
		}
	}
}
